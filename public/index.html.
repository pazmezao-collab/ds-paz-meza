<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Sistema de diseño del Mapa del Desempleo en Chile: producto, tokens, componentes, patrones, estados y reglas editoriales.">
  <meta name="theme-color" content="#f6f4ee">
  <title>Design System · Mapa del Desempleo en Chile</title>
  <style>
    :root {
      --color-ink: #16252e;
      --color-muted: #53636d;
      --color-accent: #0e615a;
      --color-accent-dark: #0b4945;
      --color-accent-soft: #d9eeea;
      --color-canvas: #f6f4ee;
      --color-surface: #ffffff;
      --color-border: #d9e0dc;
      --color-warning: #7a4b00;
      --color-warning-bg: #fff1d6;
      --color-danger: #9b2c2c;
      --color-danger-bg: #fce8e6;
      --shadow-card: 0 12px 34px rgba(22,37,46,.07);
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 22px;
      --space-1: 4px;
      --space-2: 8px;
      --space-3: 12px;
      --space-4: 16px;
      --space-5: 24px;
      --space-6: 32px;
      --space-7: 48px;
      --content-max: 1180px;
      --font-body: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      --font-display: Georgia, "Times New Roman", serif;
      color-scheme: light;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 88px; }
    body { margin: 0; background: var(--color-canvas); color: var(--color-ink); font-family: var(--font-body); line-height: 1.55; }
    a { color: var(--color-accent-dark); text-underline-offset: 3px; }
    a:hover { text-decoration-thickness: 2px; }
    button, input, select { font: inherit; }
    button, a, input, select { outline-offset: 3px; }
    :focus-visible { outline: 3px solid #b15a00; outline-offset: 3px; }
    .skip-link { position: absolute; left: 12px; top: -70px; z-index: 99; padding: 10px 14px; background: white; border: 2px solid var(--color-accent); border-radius: 8px; }
    .skip-link:focus { top: 12px; }
    .site-header { background: var(--color-surface); border-bottom: 1px solid var(--color-border); }
    .header-inner { max-width: var(--content-max); margin: auto; padding: 22px 28px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .brand-mark { width: 42px; height: 42px; flex: 0 0 42px; display: grid; place-items: center; color: white; background: var(--color-accent); border-radius: 13px; font-weight: 800; letter-spacing: -.06em; }
    .brand-name { margin: 0; font-weight: 800; font-size: 14px; letter-spacing: .03em; line-height: 1.2; }
    .brand-sub { margin: 4px 0 0; font-size: 12px; color: var(--color-muted); }
    .version-pill, .eyebrow { font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    .version-pill { border: 1px solid var(--color-border); border-radius: 999px; padding: 7px 11px; color: var(--color-muted); white-space: nowrap; }
    .hero { max-width: var(--content-max); margin: auto; padding: 48px 28px 38px; }
    .eyebrow { color: var(--color-accent); margin: 0 0 10px; }
    h1, h2, h3, h4, p { overflow-wrap: anywhere; }
    h1 { max-width: 850px; margin: 0; font: 500 clamp(38px, 6vw, 64px)/.99 var(--font-display); letter-spacing: -.045em; }
    .hero-copy { max-width: 700px; color: var(--color-muted); font-size: 17px; margin: 18px 0 0; }
    .hero-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
    .meta-chip { display: inline-flex; gap: 7px; align-items: center; background: #e9efeb; padding: 7px 11px; border-radius: 999px; font-size: 12px; font-weight: 700; }
    .status-banner { max-width: var(--content-max); margin: 0 auto 24px; padding: 0 28px; }
    .status-inner { background: var(--color-warning-bg); border: 1px solid #e7c98e; border-radius: var(--radius-md); padding: 17px 19px; display: grid; grid-template-columns: 28px 1fr; gap: 12px; color: #4b3308; }
    .status-icon { width: 26px; height: 26px; display: grid; place-items: center; border: 1.5px solid currentColor; border-radius: 50%; font-weight: 900; }
    .status-inner strong { display: block; margin-bottom: 3px; }
    .status-inner p { margin: 0; font-size: 13px; }
    .status-inner a { color: #4b3308; font-weight: 800; }
    .layout { max-width: var(--content-max); margin: 0 auto; padding: 0 28px 70px; display: grid; grid-template-columns: 230px minmax(0,1fr); gap: 32px; align-items: start; }
    .sidebar { position: sticky; top: 18px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 18px 12px; box-shadow: 0 4px 16px rgba(22,37,46,.03); }
    .sidebar-title { margin: 0 8px 11px; color: var(--color-muted); font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; }
    .nav-list { display: grid; gap: 3px; }
    .nav-list a { text-decoration: none; color: var(--color-muted); font-size: 12px; font-weight: 700; display: flex; align-items: center; gap: 9px; padding: 9px 10px; border-radius: 8px; }
    .nav-list a:hover, .nav-list a.active { color: var(--color-accent-dark); background: var(--color-accent-soft); }
    .nav-num { color: #82918d; font-variant-numeric: tabular-nums; width: 18px; }
    main { min-width: 0; }
    .section { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); margin-bottom: 22px; padding: clamp(22px, 4vw, 34px); box-shadow: var(--shadow-card); scroll-margin-top: 20px; }
    .section-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 23px; }
    .section-kicker { margin: 0 0 6px; font-size: 10px; color: var(--color-accent); letter-spacing: .14em; font-weight: 900; text-transform: uppercase; }
    h2 { font: 500 clamp(27px,3.8vw,38px)/1.05 var(--font-display); letter-spacing: -.035em; margin: 0; }
    h3 { margin: 0 0 10px; font-size: 16px; line-height: 1.25; }
    h4 { font-size: 13px; margin: 0 0 7px; }
    .section-intro { color: var(--color-muted); max-width: 750px; margin: 10px 0 0; font-size: 14px; }
    .section-number { font: 500 32px/1 var(--font-display); color: #b8c5c0; }
    .grid-2 { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; }
    .grid-4 { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10px; }
    .panel { border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 16px; min-width: 0; }
    .panel.soft { background: #f7faf8; }
    .panel.dark { background: var(--color-ink); color: white; border-color: var(--color-ink); }
    .panel.dark p, .panel.dark small { color: #d3dedb; }
    .panel p { margin: 0; font-size: 13px; color: var(--color-muted); }
    .panel-label { font-size: 10px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; color: var(--color-muted); margin-bottom: 8px; }
    .dark .panel-label { color: #b8d8d1; }
    .casilla { min-height: 150px; display: flex; flex-direction: column; gap: 8px; }
    .casilla-num { width: 25px; height: 25px; display: grid; place-items: center; border-radius: 50%; background: var(--color-accent-soft); color: var(--color-accent-dark); font-size: 11px; font-weight: 900; }
    .casilla h3 { font-size: 14px; margin: 0; }
    .casilla p { font-size: 12px; }
    .note { border-left: 3px solid var(--color-accent); background: #f3f8f6; padding: 13px 15px; border-radius: 0 10px 10px 0; font-size: 13px; color: var(--color-muted); }
    .note strong { color: var(--color-ink); }
    .principle { display: flex; gap: 12px; align-items: flex-start; border-bottom: 1px solid var(--color-border); padding: 13px 0; }
    .principle:last-child { border-bottom: 0; }
    .principle-icon { width: 30px; height: 30px; flex: 0 0 30px; display: grid; place-items: center; border-radius: 9px; background: var(--color-accent-soft); color: var(--color-accent-dark); font-weight: 900; }
    .principle p { margin: 0; color: var(--color-muted); font-size: 13px; }
    .token-group { margin-top: 19px; }
    .token-group:first-child { margin-top: 0; }
    .token-group-title { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; padding-bottom: 9px; border-bottom: 1px solid var(--color-border); margin-bottom: 12px; }
    .token-group-title h3 { margin: 0; font-size: 14px; }
    .token-group-title span { color: var(--color-muted); font-size: 11px; }
    .swatch-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 9px; }
    .swatch { border: 1px solid var(--color-border); border-radius: 11px; overflow: hidden; }
    .swatch-color { height: 58px; }
    .swatch-info { padding: 9px; display: grid; gap: 2px; }
    .swatch-info strong { font-size: 11px; }
    .swatch-info code { font-size: 10px; color: var(--color-muted); }
    .swatch-info button { justify-self: start; border: 0; background: transparent; color: var(--color-accent-dark); padding: 3px 0 0; cursor: pointer; font-size: 10px; font-weight: 800; }
    .type-sample { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 1px solid var(--color-border); padding: 10px 0; gap: 12px; }
    .type-sample:last-child { border: 0; }
    .type-sample span:last-child { color: var(--color-muted); font-size: 11px; white-space: nowrap; }
    .space-row { display: grid; grid-template-columns: 65px 1fr 40px; gap: 10px; align-items: center; padding: 7px 0; }
    .space-row code { font-size: 11px; }
    .space-bar { height: 9px; border-radius: 99px; background: var(--color-accent); }
    .space-row span { font-size: 11px; color: var(--color-muted); text-align: right; }
    .button-row { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; }
    .btn { min-height: 40px; border-radius: 9px; padding: 9px 14px; border: 1px solid var(--color-accent); background: var(--color-accent); color: white; font-size: 12px; font-weight: 800; cursor: pointer; transition: background .16s, transform .16s; }
    .btn:hover { background: var(--color-accent-dark); transform: translateY(-1px); }
    .btn.secondary { color: var(--color-accent-dark); background: white; border-color: #a7c6bf; }
    .btn.secondary:hover { background: var(--color-accent-soft); }
    .btn.tertiary { background: transparent; border-color: transparent; color: var(--color-accent-dark); text-decoration: underline; text-underline-offset: 3px; }
    .btn:disabled { cursor: not-allowed; opacity: .48; transform: none; }
    .tag { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 5px 9px; background: var(--color-accent-soft); color: var(--color-accent-dark); font-size: 10px; font-weight: 900; }
    .tag.neutral { background: #eef1ef; color: #43515a; }
    .tag.warning { background: var(--color-warning-bg); color: var(--color-warning); }
    .tag.error { background: var(--color-danger-bg); color: var(--color-danger); }
    .field { display: grid; gap: 6px; }
    .field label { font-size: 11px; font-weight: 800; }
    .field input, .field select { width: 100%; min-height: 42px; border: 1px solid #9eaca7; border-radius: 9px; padding: 9px 11px; color: var(--color-ink); background: white; }
    .field small { font-size: 10px; color: var(--color-muted); }
    .component-card { border: 1px solid var(--color-border); border-radius: 14px; padding: 15px; min-width: 0; }
    .component-card h4 { margin-bottom: 7px; }
    .component-rule { display: grid; gap: 6px; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--color-border); font-size: 11px; }
    .component-rule p { margin: 0; }
    .use { color: var(--color-accent-dark); }
    .avoid { color: var(--color-danger); }
    .stat-card { background: var(--color-ink); color: white; border-radius: var(--radius-md); padding: 20px; }
    .stat-card .small-label { color: #c4d6d0; font-size: 10px; text-transform: uppercase; letter-spacing: .12em; font-weight: 900; }
    .stat-card .big-number { font: 500 clamp(42px,6vw,62px)/1 var(--font-display); letter-spacing: -.05em; margin: 12px 0 8px; font-variant-numeric: tabular-nums; }
    .stat-card .detail { color: #e1eae7; font-size: 12px; }
    .comparison { border: 1px solid var(--color-border); border-radius: 12px; padding: 14px; }
    .compare-line { display: grid; grid-template-columns: 90px 1fr 52px; align-items: center; gap: 10px; margin: 10px 0; font-size: 11px; }
    .bar-track { height: 9px; background: #e9eeeb; border-radius: 99px; overflow: hidden; }
    .bar-fill { height: 100%; width: 0; background: var(--color-accent); border-radius: 99px; }
    .compare-line strong { text-align: right; font-variant-numeric: tabular-nums; }
    .map-layout { display: grid; grid-template-columns: minmax(150px,.75fr) minmax(0,1.25fr); gap: 16px; align-items: center; }
    .schematic-map { border: 1px solid var(--color-border); border-radius: 14px; background: #f8faf9; padding: 15px; display: flex; justify-content: center; gap: 14px; min-height: 390px; }
    .map-spine { width: 92px; display: grid; grid-template-rows: repeat(16,1fr); gap: 3px; transform: skewY(-5deg); }
    .map-region { border: 1px solid rgba(11,73,69,.22); border-radius: 3px 10px 3px 10px; min-height: 14px; padding: 0 4px; color: #153a37; font-size: 8px; font-weight: 900; cursor: pointer; transition: outline .12s, transform .12s; }
    .map-region:nth-child(3n+1) { width: 70%; justify-self: center; }
    .map-region:nth-child(3n+2) { width: 88%; justify-self: center; }
    .map-region:nth-child(3n) { width: 100%; justify-self: center; }
    .map-region.selected { outline: 3px solid var(--color-ink); outline-offset: 1px; transform: scale(1.04); z-index: 1; }
    .map-region:hover { filter: brightness(.94); }
    .map-labels { display: grid; align-content: center; gap: 5px; color: var(--color-muted); font-size: 10px; }
    .legend { display: flex; flex-wrap: wrap; gap: 9px 14px; margin-top: 13px; font-size: 10px; color: var(--color-muted); }
    .legend-item { display: inline-flex; align-items: center; gap: 6px; }
    .legend-chip { width: 13px; height: 13px; border-radius: 3px; display: inline-block; border: 1px solid rgba(0,0,0,.1); }
    .source-line { border: 1px solid var(--color-border); background: #f8faf9; border-radius: 11px; padding: 12px 13px; display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; font-size: 11px; }
    .source-line p { margin: 0; color: var(--color-muted); }
    .source-line strong { color: var(--color-ink); }
    .table-wrap { overflow-x: auto; border: 1px solid var(--color-border); border-radius: 12px; }
    table { width: 100%; border-collapse: collapse; min-width: 570px; font-size: 12px; }
    th, td { text-align: left; padding: 11px 12px; border-bottom: 1px solid var(--color-border); }
    th { background: #f2f6f3; color: var(--color-muted); font-size: 10px; text-transform: uppercase; letter-spacing: .07em; position: sticky; top: 0; }
    td.num { font-variant-numeric: tabular-nums; text-align: right; }
    tr:last-child td { border-bottom: 0; }
    tr.selected-row { background: #eaf4f1; }
    .table-select { border: 0; background: transparent; color: var(--color-accent-dark); font-weight: 800; cursor: pointer; padding: 0; text-decoration: underline; text-underline-offset: 3px; }
    .preview-controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 13px; }
    .preview-switch { border: 1px solid var(--color-border); background: white; color: var(--color-muted); padding: 7px 11px; border-radius: 999px; font-size: 11px; font-weight: 800; cursor: pointer; }
    .preview-switch[aria-pressed="true"] { color: white; background: var(--color-accent); border-color: var(--color-accent); }
    .preview-stage { padding: 20px; background: #edf1ed; border-radius: 15px; display: flex; justify-content: center; overflow: auto; }
    .preview-screen { width: 100%; max-width: 760px; background: white; border: 1px solid #cdd8d2; border-radius: 12px; padding: 23px; transition: max-width .2s; }
    .preview-stage.mobile .preview-screen { max-width: 340px; border-radius: 27px; border: 6px solid #1b292f; padding: 19px 14px; }
    .preview-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 10px; color: var(--color-muted); font-weight: 900; letter-spacing: .08em; }
    .preview-title { font: 500 27px/1.05 var(--font-display); margin: 18px 0 7px; letter-spacing: -.03em; }
    .preview-sub { color: var(--color-muted); font-size: 10px; margin: 0 0 15px; }
    .preview-metrics { display: grid; grid-template-columns: 1.2fr 1fr; gap: 10px; }
    .preview-primary { padding: 15px; background: var(--color-ink); color: white; border-radius: 11px; }
    .preview-primary span { display: block; color: #c2d8d1; font-size: 8px; font-weight: 900; letter-spacing: .1em; }
    .preview-primary strong { display: block; font: 500 42px/1 var(--font-display); margin: 8px 0; }
    .preview-primary small { color: #e0e9e6; font-size: 9px; }
    .preview-secondary { display: grid; gap: 8px; }
    .mini-metric { background: #f1f6f3; border-radius: 9px; padding: 11px; }
    .mini-metric span { display: block; font-size: 8px; color: var(--color-muted); }
    .mini-metric strong { font-size: 20px; font-variant-numeric: tabular-nums; }
    .preview-map { height: 85px; margin-top: 12px; border-radius: 9px; background: #f4f7f4; border: 1px solid var(--color-border); display: grid; place-items: center; color: var(--color-muted); font-size: 10px; }
    .preview-foot { font-size: 8px; color: var(--color-muted); margin-top: 13px; border-top: 1px solid var(--color-border); padding-top: 9px; }
    .state-card { min-height: 130px; display: flex; flex-direction: column; justify-content: center; gap: 8px; }
    .spinner { width: 23px; height: 23px; border: 3px solid #dce8e4; border-top-color: var(--color-accent); border-radius: 50%; animation: spin 1s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .state-error { background: var(--color-danger-bg); color: #632020; border-color: #e9c4c1; }
    .empty-dash { width: 44px; height: 30px; border: 1px dashed #aab8b2; border-radius: 7px; display: grid; place-items: center; color: var(--color-muted); font-weight: 900; }
    .voice-list { display: grid; gap: 10px; }
    .voice-item { display: grid; grid-template-columns: 125px 1fr; gap: 12px; padding-bottom: 10px; border-bottom: 1px solid var(--color-border); font-size: 12px; }
    .voice-item:last-child { border-bottom: 0; }
    .voice-item strong { color: var(--color-accent-dark); }
    .contrast-row { display: grid; grid-template-columns: 1fr auto auto; gap: 10px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--color-border); font-size: 11px; }
    .contrast-row:last-child { border: 0; }
    .contrast-ratio { font-variant-numeric: tabular-nums; font-weight: 900; }
    .footer { background: var(--color-ink); color: white; padding: 28px; }
    .footer-inner { max-width: var(--content-max); margin: auto; display: flex; justify-content: space-between; gap: 24px; align-items: flex-start; }
    .footer p { margin: 4px 0 0; color: #d1dfda; font-size: 12px; max-width: 720px; }
    .footer a { color: #b8e3d8; }
    .small-muted { font-size: 11px; color: var(--color-muted); }
    .mt-16 { margin-top: 16px; }
    .mb-10 { margin-bottom: 10px; }
    .no-margin { margin: 0; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
    @media (max-width: 900px) {
      .layout { grid-template-columns: 1fr; gap: 18px; }
      .sidebar { position: static; padding: 12px; }
      .nav-list { display: flex; overflow-x: auto; padding-bottom: 3px; }
      .nav-list a { white-space: nowrap; }
      .sidebar-title { display: none; }
      .grid-4 { grid-template-columns: repeat(2,minmax(0,1fr)); }
    }
    @media (max-width: 620px) {
      .header-inner, .hero, .status-banner, .layout { padding-left: 16px; padding-right: 16px; }
      .header-inner { padding-top: 15px; padding-bottom: 15px; }
      .version-pill { display: none; }
      .hero { padding-top: 34px; }
      .hero-copy { font-size: 15px; }
      .status-inner { padding: 13px; }
      .section { padding: 20px 16px; border-radius: 17px; }
      .grid-2, .grid-3 { grid-template-columns: 1fr; }
      .swatch-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
      .map-layout { grid-template-columns: 1fr; }
      .schematic-map { min-height: 330px; }
      .map-spine { width: 100px; }
      .section-head { margin-bottom: 17px; }
      .section-number { font-size: 24px; }
      .preview-metrics { grid-template-columns: 1fr; }
      .preview-secondary { grid-template-columns: repeat(2,minmax(0,1fr)); }
      .voice-item { grid-template-columns: 1fr; gap: 3px; }
      .footer-inner { display: block; }
      .footer-inner > span { display: block; margin-top: 14px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <header class="site-header">
    <div class="header-inner">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">MD</div>
        <div>
          <p class="brand-name">MAPA DEL DESEMPLEO</p>
          <p class="brand-sub">Sistema de diseño · Chile</p>
        </div>
      </div>
      <span class="version-pill">Design system · v1.0 · Paz Meza</span>
    </div>
  </header>

  <section class="hero">
    <p class="eyebrow">Manual de producto y de interfaz</p>
    <h1>Una cifra clara.<br>Una fuente a la vista.</h1>
