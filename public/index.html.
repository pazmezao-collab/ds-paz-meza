      setText("comparison-gap", gap === 0 ? "La tasa coincide con el promedio nacional." : `${r.region} está ${fmt(Math.abs(gap))} pp. ${gap > 0 ? "sobre" : "bajo"} el promedio nacional.`);
      $("comparison-region-bar").style.width = `${Math.min(100, r.tasa / 14 * 100)}%`;
      $("comparison-national-bar").style.width = `${Math.min(100, payload.nacional.tasa / 14 * 100)}%`;
      setText("organism-region-label", `${r.region} · último dato del agente`);
      setText("organism-region-rate", `${fmt(r.tasa)}%`);
      setText("organism-region-summary", `${fmtPP(r.variacion_pp)} en doce meses · ${fmt(Math.abs(gap))} pp. ${gap >= 0 ? "sobre" : "bajo"} Chile`);
      setText("preview-region-name", r.region.toLocaleUpperCase("es-CL"));
      setText("preview-rate", `${fmt(r.tasa)}%`);
      setText("preview-change", `${fmtPP(r.variacion_pp)} en doce meses`);
      setText("preview-national", `${fmt(payload.nacional.tasa)}%`);
      setText("preview-gap", `${gap > 0 ? "+" : gap < 0 ? "−" : ""}${fmt(Math.abs(gap))} pp.`);
      setText("preview-source", `Fuente: INE · Boletín ${payload.boletin} · ${payload.trimestre} · ${payload.fecha_publicacion}`);
      setText("source-name", r.fuente || `INE · ${r.region}`);
      setText("source-period", `${payload.trimestre} · publicado ${payload.fecha_publicacion}`);
      $("source-link").href = r.url || payload.nacional.url;
      ["region-atom", "preview-region"].forEach(id => { if ($(id)) $(id).value = r.region; });
      document.querySelectorAll(".map-region").forEach(btn => btn.classList.toggle("selected", btn.dataset.region === r.region));
      renderTable($("table-search").value || "");
    }
    function renderMap() {
      const spine = $("map-spine");
      spine.innerHTML = regionOrder.map(name => {
        const r = payload.regiones.find(x => x.region === name); if (!r) return "";
        return `<button class="map-region" type="button" data-region="${escapeHtml(r.region)}" aria-label="Seleccionar ${escapeHtml(r.region)}: ${fmt(r.tasa)} por ciento" title="${escapeHtml(r.region)}: ${fmt(r.tasa)}%" style="background:${colorFor(r.tasa)}">${escapeHtml(r.codigo)}</button>`;
      }).join("");
      spine.querySelectorAll("button").forEach(btn => btn.addEventListener("click", () => selectRegion(btn.dataset.region)));
    }
    function renderTable(query = "") {
      const q = query.trim().toLocaleLowerCase("es-CL");
      const rows = payload.regiones.filter(r => r.region.toLocaleLowerCase("es-CL").includes(q));
      $("regions-table").innerHTML = rows.map(r => `<tr class="${r.region === selectedRegion ? "selected-row" : ""}"><td><button class="table-select" type="button" data-region="${escapeHtml(r.region)}">${escapeHtml(r.region)}</button></td><td class="num">${fmt(r.tasa)}%</td><td class="num">${fmtPP(r.variacion_pp)}</td></tr>`).join("") || `<tr><td colspan="3">No encontramos esa región.</td></tr>`;
      $("regions-table").querySelectorAll("button[data-region]").forEach(btn => btn.addEventListener("click", () => selectRegion(btn.dataset.region)));
    }
    function selectRegion(name) { selectedRegion = name; renderSelection(); }
    async function loadAgentData() {
      try {
        const response = await fetch(API_URL, {headers:{"Accept":"application/json"}, cache:"no-store"});
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const incoming = await response.json();
        if (!incoming || !Array.isArray(incoming.regiones) || !incoming.nacional) throw new Error("Formato de respuesta inesperado");
        payload = incoming; liveApiLoaded = true;
        selectedRegion = payload.regiones.some(r => r.region === "Biobío") ? "Biobío" : payload.regiones[0].region;
        fillSelectors(); renderMap(); renderSelection();
        document.documentElement.dataset.dataSource = "api";
        const statusText = document.querySelector(".status-inner p");
        if (Number(payload.boletin) < 336) {
          statusText.innerHTML = `El endpoint respondió correctamente y entrega el Boletín ${escapeHtml(payload.boletin)} (${escapeHtml(payload.trimestre)}; publicación ${escapeHtml(payload.fecha_publicacion)}). El INE ya publicó el Boletín 336 el 29-10-2026. La interfaz identifica el período recibido para no presentarlo como el más reciente. <a href="https://regiones.ine.gob.cl/documentos/default-source/region-viii/estadisticas/ocupacion-y-desocupacion/boletines/2026/boletin-empleo-biobio-trimestre-movil-julio-septiembre-2026.pdf" target="_blank" rel="noopener">Boletín regional 336</a> · <a href="https://www.ine.gob.cl/sala-de-prensa/prensa/general/noticia/2026/10/29/la-tasa-de-desocupaci%C3%B3n-nacional-fue-9-8-en-el-trimestre-julio-septiembre-de-2026" target="_blank" rel="noopener">Boletín nacional 336</a>.`;
        } else {
          document.querySelector(".status-inner").style.display = "none";
        }
      } catch (error) {
        // Se mantiene el respaldo local y se informa que no se obtuvo una conexión en vivo.
        document.documentElement.dataset.dataSource = "respaldo";
        const status = document.querySelector(".status-inner p");
        status.innerHTML = `No se pudo consultar el endpoint durante esta carga. La página muestra el respaldo local tomado de la respuesta compartida por Paz: Boletín ${fallbackPayload.boletin}, ${fallbackPayload.trimestre}. <strong>No es una confirmación de datos en vivo.</strong> Comprueba la conexión antes de publicar.`;
      }
    }
    document.querySelectorAll("[data-copy]").forEach(button => button.addEventListener("click", async () => {
      const value = button.dataset.copy;
      try { await navigator.clipboard.writeText(value); button.textContent = "Copiado"; }
      catch { button.textContent = value; }
      window.setTimeout(() => button.textContent = "Copiar valor", 1600);
    }));
    $("region-atom").addEventListener("change", e => selectRegion(e.target.value));
    $("preview-region").addEventListener("change", e => selectRegion(e.target.value));
    $("table-search").addEventListener("input", e => renderTable(e.target.value));
    document.querySelectorAll("[data-preview]").forEach(button => button.addEventListener("click", () => {
      const mobile = button.dataset.preview === "mobile";
      $("preview-stage").classList.toggle("mobile", mobile);
      document.querySelectorAll("[data-preview]").forEach(b => b.setAttribute("aria-pressed", String(b === button)));
    }));
    $("retry-demo").addEventListener("click", async () => {
      const button = $("retry-demo");
      button.textContent = "Consultando…";
      button.disabled = true;
      await loadAgentData();
      button.textContent = liveApiLoaded ? "Conexión comprobada" : "No se pudo conectar";
      window.setTimeout(() => { button.textContent = "Intentar conexión"; button.disabled = false; }, 1800);
    });
    const observer = new IntersectionObserver(entries => entries.forEach(entry => {
      if (entry.isIntersecting) {
        document.querySelectorAll(".nav-list a").forEach(a => a.classList.toggle("active", a.getAttribute("href") === `#${entry.target.id}`));
      }
    }), {rootMargin:"-15% 0px -70% 0px"});
    document.querySelectorAll("main .section").forEach(section => observer.observe(section));
    fillSelectors(); renderMap(); renderSelection();
    loadAgentData();
  </script>
</body>
</html>
